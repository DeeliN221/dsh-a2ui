{
  "name": "dsh-a2ui",
  "version": "0.3.0",
  "description": "A2UI interactive surfaces for the DSH Web UI: the agent streams a declarative A2UI document and the client renders it inline, live, as a native interactive card.",
  "author": "sondge (upstream), DeeliN221 (fork maintainer)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeeliN221/dsh-a2ui.git"
  },
  "homepage": "https://github.com/DeeliN221/dsh-a2ui#readme",
  "bugs": {
    "url": "https://github.com/DeeliN221/dsh-a2ui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "a2ui",
    "agent-ui",
    "generative-ui",
    "interactive-cards"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepublishOnly": "npm run build",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@ant-design/x-card": "^2.9.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "katex": "^0.18.4",
    "mermaid": "^11.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
